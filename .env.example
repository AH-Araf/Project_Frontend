# Project URL from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=

# anon public key from the same page
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key from the same page. Server only. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Database password from Project Settings → Database. Used only to apply SQL.
SUPABASE_DB_PASSWORD=

# Google AI Studio key. Server only. Fallback when the local Hugging Face model cannot answer or embed.
GEMINI_API_KEY=
